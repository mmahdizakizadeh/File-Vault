generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TeacherUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  exercises    ExerciseSeries[]
  auditLogs    AuditLog[]
}

model University {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  courses   Course[]
}

model Course {
  id           String   @id @default(cuid())
  universityId String
  name         String
  code         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  exercises    ExerciseSeries[]
  submissions  Submission[]
  @@unique([universityId, name])
  @@index([universityId, active])
}

model ExerciseSeries {
  id          String   @id @default(cuid())
  courseId    String
  createdById String
  title       String
  description String?  @db.Text
  deadlineAt  DateTime?
  publishedAt DateTime @default(now())
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy   TeacherUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  files       ExerciseFile[]
  submissions Submission[]
  @@index([courseId, archivedAt, publishedAt])
}

model ExerciseFile {
  id               String   @id @default(cuid())
  exerciseSeriesId String
  originalName     String
  storedName       String   @unique
  mimeType         String
  sizeBytes        Int
  sha256           String
  createdAt        DateTime @default(now())
  exerciseSeries   ExerciseSeries @relation(fields: [exerciseSeriesId], references: [id], onDelete: Cascade)
  @@index([exerciseSeriesId])
}

model Submission {
  id                String   @id @default(cuid())
  receiptTokenHash  String?  @unique
  exerciseSeriesId  String
  courseId          String
  studentFirstName  String
  studentLastName   String
  studentNumber     String?
  studentEmail      String?
  submittedAt       DateTime @default(now())
  attemptNumber     Int      @default(1)
  exerciseSeries    ExerciseSeries @relation(fields: [exerciseSeriesId], references: [id], onDelete: Restrict)
  course            Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  files             SubmissionFile[]
  @@index([courseId, submittedAt])
  @@index([exerciseSeriesId, submittedAt])
  @@index([studentNumber, courseId])
}

model SubmissionFile {
  id           String   @id @default(cuid())
  submissionId String
  originalName String
  storedName   String   @unique
  mimeType     String
  sizeBytes    Int
  sha256       String
  createdAt    DateTime @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  @@index([submissionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  teacherId  String?
  action     String
  entityType String
  entityId   String?
  createdAt  DateTime @default(now())
  teacher    TeacherUser? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  @@index([teacherId, createdAt])
  @@index([entityType, entityId])
}
