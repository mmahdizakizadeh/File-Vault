# PostgreSQL connection. Create this database before running migrations.
DATABASE_URL="postgresql://filevault_user:CHANGE_ME@localhost:5432/filevault?schema=public"
PORT=4000
NODE_ENV=development
# Exact frontend origins, comma-separated; do not use * with credentials.
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"
# Generate with: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
# Storage stays outside the public web root.
STORAGE_DIR="./storage"
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=10
# Set true only behind HTTPS in production.
COOKIE_SECURE=false
